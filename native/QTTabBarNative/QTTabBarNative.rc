#include <windows.h>

IDR_QTTABBARNATIVE REGISTRY "QTTabBarNative.rgs"
IDR_QTTABBARCLASS REGISTRY "QTTabBarClass.rgs"
IDR_AUTOLOADERNATIVE REGISTRY "AutoLoaderNative.rgs"
IDR_QTSECONDVIEWBAR REGISTRY "QTSecondViewBar.rgs"
IDR_QTBUTTONBAR REGISTRY "QTButtonBar.rgs"
IDR_QTDESKTOPTOOL REGISTRY "QTDesktopTool.rgs"

IDR_QTTABBAR_CONTEXT_MENU MENU
BEGIN
    POPUP "&Tabs"
    BEGIN
        MENUITEM "&New Tab", ID_CONTEXT_NEWTAB
        MENUITEM "&Close Tab", ID_CONTEXT_CLOSETAB
        MENUITEM "Close Tabs to the &Right", ID_CONTEXT_CLOSE_RIGHT
        MENUITEM "Close Tabs to the &Left", ID_CONTEXT_CLOSE_LEFT
        MENUITEM "Close &Other Tabs", ID_CONTEXT_CLOSE_OTHERS
        MENUITEM "Restore &Last Closed", ID_CONTEXT_RESTORELASTCLOSED
        MENUITEM SEPARATOR
        POPUP "Add to &Group"
        BEGIN
            MENUITEM "(empty)", ID_CONTEXT_GROUP_BASE
        END
        MENUITEM "Create &Group...", ID_CONTEXT_CREATE_GROUP
        MENUITEM SEPARATOR
        MENUITEM "&Lock Tab", ID_CONTEXT_TOGGLE_LOCK
        MENUITEM "&Clone Tab", ID_CONTEXT_CLONE_TAB
        MENUITEM "Open in New &Window", ID_CONTEXT_OPEN_NEW_WINDOW
        MENUITEM "&Copy Path", ID_CONTEXT_COPY_PATH
        MENUITEM "&Properties", ID_CONTEXT_PROPERTIES
        POPUP "&History"
        BEGIN
            MENUITEM "(empty)", ID_CONTEXT_HISTORY_BASE
            MENUITEM "&Clear History", ID_CONTEXT_HISTORY_CLEAR
        END
        MENUITEM "Open &Command Prompt Here", ID_CONTEXT_OPEN_COMMAND
        MENUITEM "Edit &Alias...", ID_CONTEXT_EDIT_ALIAS
        MENUITEM SEPARATOR
        MENUITEM "&Refresh", ID_CONTEXT_REFRESH
        MENUITEM "&Options...", ID_CONTEXT_OPTIONS
    END
END

IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 360, 360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "QTTabBar Options"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    CONTROL         "",IDC_OPTIONS_TAB,"SysTabControl32",WS_TABSTOP | WS_CHILD | WS_CLIPSIBLINGS | WS_CLIPCHILDREN | WS_BORDER,7,7,346,330
    PUSHBUTTON      "Reset",IDC_RESET_BUTTON,102,338,50,14
    DEFPUSHBUTTON   "OK",IDOK,214,338,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,268,338,50,14
    PUSHBUTTON      "Apply",IDC_APPLY_BUTTON,322,338,50,14
END

